# Переменные окружения Stauri
#
# Скопируйте в `.env` и заполните. Все три необязательны: без них
# приложение запускается, но теряет часть возможностей.
#
#   cp .env.example .env

# Ключ Alchemy — запасной RPC-провайдер для сетей из ALCHEMY_HOSTS.
# Основной провайдер — публичный publicnode, он не требует ключа.
# Без ключа кошелёк работает; ключ помогает, если publicnode недоступен.
VITE_ALCHEMY_KEY=

# Ключ Infura. Из него status-go берёт VerifyENSURL для проверки ENS-имён
# и подставляет в прямой провайдер mainnet.infura.io.
# Без ключа проверка ENS молча пропускается.
VITE_INFURA_KEY=

# Ключ CoinGecko для вкладки Market. Читается в Rust при старте.
# Без ключа вкладка показывает «COINGECKO_KEY is not set».
COINGECKO_KEY=
