# ==========================================
# Node / SvelteKit
# ==========================================
node_modules/
.pnpm-store/
.pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.svelte-kit/
build/
dist/
.vite/
*.tsbuildinfo

# ==========================================
# Rust / Tauri
# ==========================================
src-tauri/target/
src-tauri/gen/
src-tauri/tmp/
**/*.rs.bk

# ==========================================
# Бинарные sidecar-артефакты
# ==========================================
# status-backend и libsds.so собираются в Nix (см. BUILDING.md)
# и НЕ хранятся в Git: они прикрепляются к GitHub Release как assets.
#
# Исключается содержимое, а не каталог: сам `binaries/` должен существовать
# в свежем клоне, иначе `BUILDING.md` («положите файлы сюда») и шаг CI,
# создающий пустышки, расходятся с тем, что видит человек.
src-tauri/binaries/*
!src-tauri/binaries/.gitkeep

# ==========================================
# Артефакты релиза
# ==========================================
# Сейчас `release.sh` кладёт их в `target/release/bundle/`, а он исключён
# целиком. Правила ниже — страховка на случай, если путь изменится:
# подписанный AppImage рядом с исходниками попадёт в Git незаметно, а
# весит он десятки мегабайт.
*.AppImage
*.AppImage.sha256
*.sig
latest.json

# ==========================================
# Tauri build output
# ==========================================
src-tauri/target/release/bundle/
src-tauri/target/debug/bundle/

# ==========================================
# Environment / secrets
# ==========================================
.env
.env.*
!.env.example
# Файл `env` без точки — не наш: это конфиг инструментов разработчика
# (он был закоммичен при импорте). Правило `.env` его не ловит.
env
.aider.*
*.pem
*.key
*.keystore
*.jks

# ==========================================
# Logs / runtime
# ==========================================
*.log
logs/
status.log
*.pid

# ==========================================
# Testing / reports
# ==========================================
test-results/
playwright-report/
coverage/
.vitest/

# ==========================================
# Editor / OS
# ==========================================
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ==========================================
# Misc
# ==========================================
*.tmp
tmp/
TMP/
.cache/
