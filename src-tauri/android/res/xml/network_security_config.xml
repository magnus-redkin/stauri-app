<?xml version="1.0" encoding="utf-8"?>
<!--
  What the application may send over the network.

  `usesCleartextTraffic` in the manifest is a manifest placeholder that the debug build
  turns on and the release build turns off. Pairing with another device needs plain TCP
  on the local network (the status-go local-pairing transport is a multiaddr connection,
  not HTTP), so the release build has to allow cleartext to private addresses only —
  the placeholder alone would block it entirely.

  Public addresses stay HTTPS-only: a provider URL with `http://` must not silently
  work.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Local pairing and the RPC forwarder both listen on loopback. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
